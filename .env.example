# Copy to .env (git-ignored) and change the password.
# docker-compose.yml builds the in-container DATABASE_URL / REDIS_URL from these.

POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus

# Only needed when running the server directly on your machine (outside Docker):
# DATABASE_URL=postgresql://argus:change-me@localhost:5432/argus
# REDIS_URL=redis://localhost:6379/0

# --- Debate Arena (make demo / make traffic): real models only ---
# Paste the key printed by `make seed` here:
ARGUS_API_KEY=
# Pro and con: local Ollama (OpenAI-compatible API). Run `ollama pull llama3.2:3b` first.
PRO_BASE_URL=http://host.docker.internal:11434/v1/
PRO_MODEL=llama3.2:3b
PRO_API_KEY=ollama
CON_BASE_URL=http://host.docker.internal:11434/v1/
CON_MODEL=llama3.2:3b
CON_API_KEY=ollama
# Judge: Groq (free tier). Create a key at https://console.groq.com/keys. Never commit it.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key
# Timeouts per LLM call (s). CPU-only Ollama needs long ones.
# PRO_TIMEOUT_S=300 / CON_TIMEOUT_S=300 / JUDGE_TIMEOUT_S=60
# 429 retries per LLM call (waits Retry-After or backs off, max 60 s per wait)
# LLM_RATE_LIMIT_RETRIES=4
# Traffic runs 2 debates at a time by default: make traffic N=10 CONCURRENCY=2
# Failure injection on top of the real calls: probability 0..1 per call
ARENA_TIMEOUT_RATE=0.05
ARENA_BAD_JSON_RATE=0.2
ARENA_SLOW_RATE=0.05

# --- Pipeline tuning (optional) ---
# STREAM_MAXLEN=1000000       # approx. cap on the Redis stream
# CLAIM_MIN_IDLE_MS=60000     # reclaim a dead worker's messages after this idle time
# WEB_CONCURRENCY=1           # API worker processes (uvicorn); 4 measured ~2.4x ingest throughput
