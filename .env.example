# Copy to .env (git-ignored) and change the password.
# docker-compose.yml builds the in-container DATABASE_URL / REDIS_URL from these.

POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus

# Only needed when running the server directly on your machine (outside Docker):
# DATABASE_URL=postgresql://argus:change-me@localhost:5432/argus
# REDIS_URL=redis://localhost:6379/0

# --- Debate Arena (make demo / make traffic) ---
# Paste the key printed by `make seed` here:
ARGUS_API_KEY=
# fake (offline) | ollama (local, OpenAI-compatible) | openai (paid; set OPENAI_API_KEY)
LLM_PROVIDER=fake
# Failure injection: probability 0..1 per call
ARENA_TIMEOUT_RATE=0.05
ARENA_BAD_JSON_RATE=0.2
ARENA_SLOW_RATE=0.05
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=
# PRO_MODEL= / CON_MODEL= / JUDGE_MODEL=   (defaults depend on LLM_PROVIDER)

# --- Pipeline tuning (optional) ---
# STREAM_MAXLEN=1000000       # approx. cap on the Redis stream
# CLAIM_MIN_IDLE_MS=60000     # reclaim a dead worker's messages after this idle time
